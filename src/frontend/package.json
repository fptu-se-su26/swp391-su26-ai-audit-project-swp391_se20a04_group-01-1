    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "mapbox-gl": "^3.24.0",
    "react": "^18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.15.1",
